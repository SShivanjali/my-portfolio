"use client";

import { useState } from "react";
import styles from "./photography.module.css";

const photos = [
  "/cam/beachPlusIcecream.jpg",
  "/cam/greenbluesky2.jpg",
  "/cam/greenbluesky3.jpg",
  "/cam/playground.jpg",
  "/cam/playground2.jpeg",
  "/cam/damanPano.jpg",
  "/cam/buildings.jpg",
  "/cam/horse.jpg",
  "/cam/sky3.jpg",
  "/cam/sisBeach.jpg",
  "/cam/cloud.jpg",
  "/cam/bougenville.jpeg",
  "/cam/chandelier.jpeg",
  "/cam/door.jpeg",
  "/cam/books.jpeg",
  "/cam/fountain.jpeg",
  "/cam/narmada-canal.jpeg",
  "/cam/read.jpeg",
  "/cam/Dblock.jpg",
  "/cam/star!.jpg",
  "/cam/cat.jpeg",
  "/cam/r-city.jpeg",
  "/cam/blurAbit.jpg",
];

// Rendered left-to-right in reverse so "future" frames sit to the left,
// and the currently-front frame is always the rightmost of that pile.
const reversed = [...photos].reverse();

export default function Photography() {
  const [count, setCount] = useState(0);

  const pullFrame = () => {
    if (count >= photos.length - 1) return;
    setCount((c) => c + 1);
  };

  return (
    <main className={styles.stage}>
      <div className={styles.clipWindow}>
        <div
          className={styles.filmTrack}
          style={{ "--count": count, "--total": photos.length }}
        >
          {reversed.map((src, i) => {
            const originalIndex = photos.length - 1 - i;
            return (
              <figure
                key={src}
                className={`${styles.frame} ${
                  originalIndex === count ? styles.front : ""
                }`}
                onClick={originalIndex === count ? pullFrame : undefined}
              >
                <img src={src} alt={`Film frame ${originalIndex + 1}`} />
              </figure>
            );
          })}
        </div>
      </div>
    </main>
  );
}


















.stage {
  --frame-w: clamp(270px, 60vw, 450px);
  --gap: 10px;
  --peek: 40px;
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #111;
}

.clipWindow {
  position: absolute;
  top: 50%;
  left: 30vw;
  right: 0;
  transform: translateY(-50%);
  overflow: hidden;
}

.filmTrack {
  display: flex;
  gap: var(--gap);
  transform: translateX(
    calc((var(--count) - (var(--total) - 1)) * (var(--frame-w) + var(--gap)) + var(--peek))
  );
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.frame {
  flex-shrink: 0;
  width: var(--frame-w);
  margin: 0;
  overflow: hidden;
  background: #000;
  border: 2px solid #2a2a2a;
  border-radius: 2px;
  box-shadow: 0 4px 24px rgb(0 0 0 / 80%);
}

.frame img {
  display: block;
  width: var(--frame-w);
  aspect-ratio: 3 / 2;
  object-fit: cover;
  pointer-events: none;
}

.front {
  cursor: pointer;
}
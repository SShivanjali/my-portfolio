"use client";

import { useState } from "react";
import styles from "./photography.module.css";

const photos = [
  "/cam/beachPlusIcecream.jpg",
  "/cam/greenbluesky2.jpg",
  "/cam/greenbluesky3.jpg",
  "/cam/playground.jpg",
  "/cam/playground2.jpeg",
  "/cam/damanPano.jpg",
  "/cam/buildings.jpg",
  "/cam/horse.jpg",
  "/cam/sky3.jpg",
  "/cam/sisBeach.jpg",
  "/cam/cloud.jpg",
  "/cam/bougenville.jpeg",
  "/cam/chandelier.jpeg",
  "/cam/door.jpeg",
  "/cam/books.jpeg",
  "/cam/fountain.jpeg",
  "/cam/narmada-canal.jpeg",
  "/cam/read.jpeg",
  "/cam/Dblock.jpg",
  "/cam/star!.jpg",
  "/cam/cat.jpeg",
  "/cam/r-city.jpeg",
  "/cam/blurAbit.jpg",
];

const frameWidth = () =>
  typeof window === "undefined"
    ? 270
    : Math.min(Math.max(270, window.innerWidth * 0.6), 450);

export default function Photography() {
  const [count, setCount] = useState(0);
  const [offset, setOffset] = useState(0);
  const [animating, setAnimating] = useState(false);
  const [reeling, setReeling] = useState(false);

  const pullFrame = () => {
    if (reeling || count >= photos.length) return;

    const shift = frameWidth() + 10;

    setCount((n) => n + 1);
    setOffset((x) => x - shift);
    setAnimating(false);

    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        setOffset((x) => x + shift);
        setAnimating(true);
      })
    );
  };

  const reelIn = () => {
    if (reeling || !count) return;

    const duration = Math.min(600 + count * 40, 1800);

    setReeling(true);
    setAnimating(true);
    setOffset((x) => x - count * (frameWidth() + 10) - 80);

    setTimeout(() => {
      setCount(0);
      setOffset(0);
      setAnimating(false);
      setReeling(false);
    }, duration);
  };

  const open = count > 0 || reeling;
  const exposed = photos.slice(0, count).reverse();

  return (
    <main className={styles.stage}>
      <img
        src="/cam/film_canister.png"
        alt="Film canister"
        className={`${styles.canister} ${open ? styles.open : ""}`}
        onClick={count ? reelIn : pullFrame}
      />

      <div className={`${styles.stripWrap} ${open ? styles.open : ""}`}>
        <div
          className={styles.filmTrack}
          style={{
            transform: `translateX(${offset}px)`,
            transition: animating
              ? "transform .48s cubic-bezier(.25,.46,.45,.94)"
              : "none",
          }}
        >
          {!open && <div className={styles.leader} />}

          {open && photos[count] && (
            <figure className={styles.peek}>
              <img src={photos[count]} alt="" />
            </figure>
          )}

          {exposed.map((src, i) => (
            <figure
              key={src}
              className={`${styles.frame} ${
                i === 0 && !reeling ? styles.front : ""
              }`}
              onClick={i === 0 && !reeling ? pullFrame : undefined}
            >
              <img src={src} alt={`Film frame ${count - i}`} />
            </figure>
          ))}
        </div>
      </div>
    </main>
  );
}

















.stage {
  --canister-w: clamp(180px, 40vw, 420px);
  --canister-left: 8vw;
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #111;
}

.canister,
.stripWrap {
  position: absolute;
  top: 50%;
  transition: left 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.canister {
  left: calc(50% - var(--canister-w) / 2);
  width: var(--canister-w);
  transform: translateY(-50%);
  z-index: 10;
  cursor: pointer;
  user-select: none;
}

.canister.open {
  left: var(--canister-left);
}

.stripWrap {
  left: calc(50% + var(--canister-w) / 2);
  transform: translateY(-50%);
  z-index: 5;
  overflow: hidden;
}

.stripWrap.open {
  left: calc(var(--canister-left) + var(--canister-w) - 4px);
}

.filmTrack {
  display: flex;
  gap: 10px;
  will-change: transform;
}

.frame,
.peek,
.leader {
  flex-shrink: 0;
  margin: 0;
  overflow: hidden;
  background: #000;
}

.frame {
  width: clamp(270px, 60vw, 450px);
  border: 2px solid #2a2a2a;
  border-radius: 2px;
  box-shadow: 0 4px 24px rgb(0 0 0 / 80%);
}

.frame img,
.peek img {
  display: block;
  width: clamp(270px, 60vw, 450px);
  aspect-ratio: 3 / 2;
  object-fit: cover;
  pointer-events: none;
}

.front {
  cursor: pointer;
}

.peek {
  width: 60px;
  border-right: 2px solid #2a2a2a;
}

.leader {
  width: 40px;
}

.leader::after {
  content: "";
  display: block;
  width: clamp(270px, 60vw, 450px);
  aspect-ratio: 3 / 2;
  background: #000;
}